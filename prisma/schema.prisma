// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

enum UserRole {
  ADMIN
  MANAGER
  ASSISTANT_MANAGER
  STAFF
}

enum UserAccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// MANAGER: required on peak shifts, highest authority
/// ASSISTANT_MANAGER: required on any shift not covered by a Manager
/// STAFF: cannot fulfill any management coverage requirement
enum ManagementTier {
  MANAGER
  ASSISTANT_MANAGER
  STAFF
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  UNPAID
}

enum TimeOffStatus {
  PENDING
  APPROVED
  DENIED
}

enum AssignmentStatus {
  SCHEDULED
  CONFIRMED
  SWAPPED
  CANCELLED
}

enum ConflictResolutionStrategy {
  SENIORITY_FIRST
  ROUND_ROBIN
  MANUAL
}

enum ScheduleRunStatus {
  SUCCESS
  FAILED
  PARTIAL
  HALTED
}

enum ViolationSeverity {
  BLOCKING
  WARNING
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model Employee {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  employment_type     EmploymentType
  weekly_hours_target Int
  hire_date           DateTime
  seniority_level     Int
  role                String
  hierarchy_rank      Int
  management_tier     ManagementTier
  specialties         String[]
  status              EmployeeStatus
  hourly_rate         Float?
  currency            String         @default("GBP")
  avatar_url          String?

  time_off_requests       TimeOffRequest[]
  assignments             Assignment[]
  constraint_violations   ConstraintViolation[] @relation("ViolationEmployee")
  swap_requests_sent      ShiftSwapRequest[]    @relation("SwapRequester")
  swap_requests_received  ShiftSwapRequest[]    @relation("SwapTarget")
  user_account            UserAccount?
  pay_summaries           PaySummary[]
}

model Shift {
  id                           String   @id @default(cuid())
  date                         DateTime
  start_time                   DateTime
  end_time                     DateTime
  duration_hours               Float
  required_specialty           String?
  min_staff_count              Int
  location                     String?
  is_peak_shift                Boolean  @default(false)
  requires_management_presence Boolean  @default(true)

  assignments           Assignment[]
  constraint_violations ConstraintViolation[] @relation("ViolationShift")
}

model TimeOffRequest {
  id          String        @id @default(cuid())
  employee_id String
  type        TimeOffType
  start_date  DateTime
  end_date    DateTime
  status      TimeOffStatus
  priority    Int
  created_at  DateTime

  employee Employee @relation(fields: [employee_id], references: [id])
}

model Assignment {
  id             String           @id @default(cuid())
  employee_id    String
  shift_id       String
  status         AssignmentStatus
  assigned_hours Float

  employee      Employee            @relation(fields: [employee_id], references: [id])
  shift         Shift               @relation(fields: [shift_id], references: [id])
  swap_requests ShiftSwapRequest[]
}

model ScheduleConfig {
  id                            String                     @id @default(cuid())
  max_consecutive_days          Int                        @default(5)
  max_weekly_hours              Int                        @default(40)
  overtime_threshold            Int                        @default(40)
  min_rest_hours_between_shifts Int
  schedule_period_days          Int                        @default(7)
  conflict_resolution_strategy  ConflictResolutionStrategy
  peak_windows                  Json
  max_team_off_percentage       Float
}

model ScheduleRun {
  id              String            @id @default(cuid())
  week_start      DateTime
  generated_at    DateTime
  config_snapshot Json
  status          ScheduleRunStatus
  error_log       String?
  errors          Json              @default("[]")
  warnings        Json              @default("[]")

  constraint_violations ConstraintViolation[]
}

model PeakWindow {
  id         String   @id @default(cuid())
  days       String[]
  start_time String
  end_time   String
  label      String?
}

model ConstraintViolation {
  id              String            @id @default(cuid())
  schedule_run_id String
  shift_id        String?
  employee_id     String?
  rule            String
  severity        ViolationSeverity
  message         String
  overridden_by   String?
  override_reason String?
  override_at     DateTime?

  schedule_run ScheduleRun @relation(fields: [schedule_run_id], references: [id])
  shift        Shift?      @relation("ViolationShift", fields: [shift_id], references: [id])
  employee     Employee?   @relation("ViolationEmployee", fields: [employee_id], references: [id])
}

enum SwapStatus {
  PENDING
  APPROVED
  DENIED
}

model ShiftSwapRequest {
  id                 String     @id @default(cuid())
  requester_id       String
  target_employee_id String
  assignment_id      String
  status             SwapStatus @default(PENDING)
  manager_note       String?
  created_at         DateTime   @default(now())
  reviewed_at        DateTime?
  reviewed_by        String?

  requester       Employee   @relation("SwapRequester", fields: [requester_id], references: [id])
  target_employee Employee   @relation("SwapTarget", fields: [target_employee_id], references: [id])
  assignment      Assignment @relation(fields: [assignment_id], references: [id])
}

// ─── Phase 9 Models ───────────────────────────────────────────────────────────

model WeeklyBudget {
  id               String   @id @default(cuid())
  week_start       DateTime @unique
  budget_hours     Float
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model HistoricalEvent {
  id           String   @id @default(cuid())
  name         String
  event_type   String
  date         DateTime
  staff_used   Int
  hours_used   Float
  notes        String?
  created_at   DateTime @default(now())
}

model UpcomingEvent {
  id                  String    @id @default(cuid())
  name                String
  event_type          String
  date                DateTime
  confirmed_staff     Int?
  notes               String?
  recommended_staff   Int?
  recommended_hours   Float?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
}

model PaySummary {
  id              String   @id @default(cuid())
  employee_id     String
  week_start      DateTime
  scheduled_hours Float
  absent_hours    Float
  worked_hours    Float
  hourly_rate     Float
  gross_pay       Float
  currency        String   @default("GBP")
  created_at      DateTime @default(now())

  employee Employee @relation(fields: [employee_id], references: [id])

  @@unique([employee_id, week_start])
}

model UserAccount {
  id               String            @id @default(cuid())
  employee_id      String            @unique
  email            String            @unique
  password_hash    String?
  role             UserRole
  status           UserAccountStatus @default(INVITED)
  invite_token     String?           @unique
  invite_expires_at DateTime?
  last_login       DateTime?
  created_at       DateTime          @default(now())

  employee Employee @relation(fields: [employee_id], references: [id])
}

model CompanyConfig {
  id           String   @id @default(cuid())
  company_name String   @default("ScheduleMgr")
  logo_url     String?
  primary_color String? @default("#4f46e5")
  updated_at   DateTime @updatedAt
}
