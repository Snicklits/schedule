{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "exclude": ["**/__tests__/**", "**/*.test.ts", "dist/**", "vitest.config.ts", "prisma/**", "client/**", "api/**"]
}
